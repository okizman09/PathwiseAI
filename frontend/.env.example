# Pathwise AI — Frontend Environment Variables
# Copy this file to frontend/.env and fill in real values.
# Only VITE_* variables are included here; they are bundled into the client
# and are therefore PUBLIC. Never put secrets here.

# ── Backend API URL ──────────────────────────────────────────────────
# Local dev: http://localhost:8000
# Production: Set to your live Render backend URL (e.g. https://pathwise-backend.onrender.com)
VITE_API_URL=http://localhost:8000

# ── Supabase Auth & Public API ───────────────────────────────────────
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Found in Project Settings -> API -> Project API Keys -> anon / public
VITE_SUPABASE_ANON_KEY=
