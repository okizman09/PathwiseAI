# Pathwise AI — Backend Environment Variables
# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env to git.

# ── Environment & Models ──────────────────────────────────────────────
ENVIRONMENT=development          # "development" | "production" (set to "production" on Render)
MODEL_API_KEY=                  # Meta Model API key from https://dev.meta.ai/ (server-only, never in frontend)
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
LLM_TIMEOUT_SECONDS=90

# ── Database ──────────────────────────────────────────────────────────
# Local dev: SQLite (default). 
# Production: Supabase Postgres connection string (e.g. postgresql://postgres.<ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres)
DATABASE_URL=sqlite:///./pathwise.db

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Local dev: http://localhost:5173,http://localhost:3000,http://localhost:8080,http://localhost:8081
# Production: Set to your Cloudflare frontend domain only (e.g. https://pathwise-ai.pages.dev or custom domain)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://localhost:8081

# ── Auth (Supabase) ───────────────────────────────────────────────────
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
# Found in Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# ── Quota (Daily Limits) ──────────────────────────────────────────────
WORKFLOWS_PER_DAY=2
INTERVIEW_TURNS_PER_DAY=25
STEP_ACTIONS_PER_DAY=20
RUN_STEPS_PER_DAY=10
GLOBAL_STEP_RUNS_PER_DAY=200
RUN_MAX_PROMPT_CHARS=6000
RUN_MAX_OUTPUT_TOKENS=8192
RUN_TIMEOUT_SECONDS=60

# ── Feature flags (F0) ────────────────────────────────────────────────
# Both default to false (off). Set to "true" to re-enable.
FEATURE_LIVE_RUN=false
FEATURE_META_SHOWCASE=false

# ── Email notifications (site feedback) ───────────────────────────────
# Fill all three to receive an email for each landing-page feedback submit.
# For Gmail, SMTP_PASSWORD is a Google App Password (Google Account ->
# Security -> 2-Step Verification -> App passwords), not the account password.
# Leave empty to disable email notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FEEDBACK_NOTIFY_TO=
